---
/** Retired directory: old bookmarks lead to the works' focused area instead. */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getDetailPages, getWorkArea } from '../../lib/content';
import { url } from '../../lib/site';

const works = await getDetailPages('choreographic-works');
const area = works.length ? await getWorkArea('page', works[0].id) : undefined;
const destination = url(area?.path ?? 'works');
const title = area?.title ?? 'Works';
---

<BaseLayout title={title} description={`Continue to ${title}.`}>
  <meta slot="head" http-equiv="refresh" content={`0;url=${destination}`} />
  <p class="prose"><a href={destination}>Continue to {title}</a></p>
</BaseLayout>
