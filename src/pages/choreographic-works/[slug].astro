---
/** Individual original choreography pages, e.g. /choreographic-works/knock-on-wood/. */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Blocks from '../../components/Blocks.astro';
import WorkEditorial from '../../components/WorkEditorial.astro';
import { getDetailPages, getWorkArea, type DetailPage } from '../../lib/content';
import { url } from '../../lib/site';
import ArrowIcon from '../../components/ArrowIcon.astro';

export async function getStaticPaths() {
  const works = await getDetailPages('choreographic-works');
  return works.map((work) => ({ params: { slug: work.id.split('/').at(-1) }, props: { work } }));
}

const { work } = Astro.props as { work: DetailPage };
const returnArea = await getWorkArea('page', work.id);
const returnPath = returnArea?.path ?? 'works';
const returnTitle = returnArea?.title ?? 'All works';
---

<BaseLayout title={work.data.title} description={work.data.summary} image={work.data.cover.src}>
  <article class="detail detail--choreographic-work">
    <header class="detail__header">
      <a class="back" href={url(returnPath)}><ArrowIcon direction="left" /> {returnTitle}</a>
      <h1 class="detail__title">{work.data.title}</h1>
      {work.data.sub && <p class="detail__sub">{work.data.sub}</p>}
    </header>
    <div class="flow">
      {work.data.layout === 'editorial-columns' ? <WorkEditorial blocks={work.data.blocks} /> : <Blocks blocks={work.data.blocks} />}
    </div>
    <nav class="pager" aria-label="Choreographic works navigation">
      <span />
      <a class="pager__link pager__link--next" href={url(returnPath)}>
        <span class="pager__dir">Back to <ArrowIcon /></span>
        <span class="pager__title">{returnTitle}</span>
      </a>
    </nav>
  </article>
</BaseLayout>
