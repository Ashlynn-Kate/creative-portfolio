---
/** One page per discipline, generated from the tags on each case. */
import BaseLayout from '../../layouts/BaseLayout.astro';
import MediaImage from '../../components/MediaImage.astro';
import DisciplineTags from '../../components/DisciplineTags.astro';
import { getCases, getDisciplines, pad } from '../../lib/content';
import { slugify, url } from '../../lib/site';

export async function getStaticPaths() {
  const disciplines = await getDisciplines();
  return disciplines.map((d) => ({ params: { slug: d.slug }, props: { name: d.name } }));
}

const { name } = Astro.props as { name: string };
const all = await getCases();
const matches = all.filter((c) => c.data.disciplines.some((d) => slugify(d) === slugify(name)));
const others = (await getDisciplines()).filter((d) => d.name !== name);
---

<BaseLayout title={name} description={`${name} work by Ashlynn Kate.`}>
  <section class="detail__header discipline__header">
    <a class="back" href={url('#disciplines')}><span aria-hidden="true">←</span> All work</a>
    <p class="eyebrow">Discipline</p>
    <h1 class="detail__title">{name}</h1>
  </section>

  <ul class="discipline__list">
    {matches.map((c) => (
      <li>
        <a class="discipline__item" href={url(`#${c.id}`)}>
          <MediaImage image={{ ...c.data.cover, highRes: undefined }} showCaption={false} sizes="(min-width: 900px) 45vw, 100vw" />
          <div>
            <p class="case__kicker"><span>Case {pad(all.indexOf(c) + 1)}</span>{c.data.status && <span class="badge">{c.data.status}</span>}</p>
            <h2 class="discipline__title">{c.data.title}</h2>
            <p>{c.data.summary}</p>
          </div>
        </a>
      </li>
    ))}
  </ul>

  {others.length > 0 && (
    <aside class="discipline__others">
      <p class="eyebrow">Other disciplines</p>
      <DisciplineTags disciplines={others.map((d) => d.name)} />
    </aside>
  )}
</BaseLayout>
