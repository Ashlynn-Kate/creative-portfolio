---
import BaseLayout from '../layouts/BaseLayout.astro';
import MediaImage from '../components/MediaImage.astro';

const portrait = {
  src: 'about/ashlynn-kate-portrait.jpeg',
  alt: 'Ashlynn Kate in a black-and-white portrait.',
};
---

<BaseLayout title="About" description="About Ashlynn Kate, a creative and artistic director.">
  <article class="about">
    <header class="about__header">
      <p class="eyebrow">About</p>
      <h1>Ashlynn Kate</h1>
    </header>

    <div class="about__content">
      <MediaImage class="about__portrait" image={portrait} eager showCaption={false} sizes="(min-width: 800px) 40vw, 100vw" />
      <p class="about__lead">I’m Ashlynn, a creative and artistic director working across live performance, film, and editorial portrait concepts.</p>
      <p>My background is rooted in dance, which shaped the way I think about movement, composition, storytelling, and the relationship between people and space. My foundation in performance includes professional dance training at The Ailey School, along with professional experience creating, choreographing, and directing work for the stage. I also perform onstage and on screen. That foundation continues to inform a multidisciplinary creative practice.</p>
      <p>I develop ideas from their earliest stages and build the visual world around them, from concept and movement to wardrobe, imagery, environment, and the details that bring everything together. My work has included directing full length productions, developing editorial portrait concepts, and leading multidisciplinary film projects.</p>
      <p>While the medium changes, my approach stays consistent. I look for the central idea, find the visual language that belongs to it, and make deliberate choices that carry that idea through to the finished work. I’m especially drawn to projects where performance, image, and storytelling can inform and build on one another.</p>
    </div>

    <section class="about__contact" aria-labelledby="contact-info">
      <p class="eyebrow" id="contact-info">Contact Info</p>
      <p><strong>Interested in working together?<br />For inquiries and collaborations contact me at <a href="mailto:hello@ashlynnkate.com">hello@ashlynnkate.com</a></strong></p>
    </section>
  </article>
</BaseLayout>
