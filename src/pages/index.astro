---
/** Category-first landing page; the case studies now have their own routes. */
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeHero from '../components/HomeHero.astro';
import HomeAreas from '../components/HomeAreas.astro';

const directory = await getEntry('workDirectories', 'works');
if (!directory) throw new Error('Missing Works directory content.');
---

<BaseLayout>
  <HomeHero
    headline="Making ideas"
    emphasis="visible."
    description="Creative work across still image, moving image, and live space."
  />
  <HomeAreas categories={directory.data.categories} />
</BaseLayout>
