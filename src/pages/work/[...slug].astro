---
/** Detail pages that belong to a case, e.g. /work/prince-of-egypt/throne-inspiration/ */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Blocks from '../../components/Blocks.astro';
import DisciplineTags from '../../components/DisciplineTags.astro';
import { casePath, getDetailPages, getCases, type DetailPage } from '../../lib/content';
import { url } from '../../lib/site';
import ArrowIcon from '../../components/ArrowIcon.astro';

export async function getStaticPaths() {
  const pages = await getDetailPages();
  // Choreographic Works has its own root-level routes so it does not appear
  // as both /work/choreographic-works/... and /choreographic-works/....
  return pages
    .filter((page) => page.data.case !== 'choreographic-works')
    .map((page) => ({ params: { slug: page.id }, props: { page } }));
}

const { page } = Astro.props as { page: DetailPage };
const parent = (await getCases()).find((c) => c.id === page.data.case);
const isLandingPage = parent?.data.landingPage === page.id;
const siblings = await getDetailPages(page.data.case);
const index = siblings.findIndex((p) => p.id === page.id);
const prev = siblings[index - 1];
const next = siblings[index + 1];
---

<BaseLayout title={page.data.title} description={page.data.summary} image={page.data.cover.src}>
  <article class="detail">
    <header class="detail__header">
      {parent && <a class="back" href={isLandingPage ? url('works') : url(casePath(parent))}>
        <ArrowIcon direction="left" /> {isLandingPage ? 'All works' : parent.data.title}
      </a>}
      <h1 class="detail__title">{page.data.title}</h1>
      {page.data.sub && <p class="detail__sub">{page.data.sub}</p>}
      {isLandingPage && parent && <DisciplineTags disciplines={parent.data.disciplines} variant="metadata" />}
    </header>

    <div class="flow">
      <Blocks blocks={page.data.blocks} />
    </div>

    {(prev || next || (parent && !isLandingPage)) && <nav class="pager" aria-label="More from this project">
      {prev ? (
        <a class="pager__link" href={url(`work/${prev.id}`)}>
          <span class="pager__dir"><ArrowIcon direction="left" /> Previous</span>
          <span class="pager__title">{prev.data.title}</span>
        </a>
      ) : <span />}
      {next ? (
        <a class="pager__link pager__link--next" href={url(`work/${next.id}`)}>
          <span class="pager__dir">Next <ArrowIcon /></span>
          <span class="pager__title">{next.data.title}</span>
        </a>
      ) : parent && !isLandingPage && (
        <a class="pager__link pager__link--next" href={url(casePath(parent))}>
          <span class="pager__dir">Back to <ArrowIcon /></span>
          <span class="pager__title">{parent.data.title}</span>
        </a>
      )}
    </nav>}
  </article>
</BaseLayout>
