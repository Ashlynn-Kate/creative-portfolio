---
/** Discipline tags that link to their discipline page. */
import { slugify, url } from '../lib/site';

interface Props {
  disciplines: string[];
  variant?: 'filters' | 'metadata';
}
const { disciplines, variant = 'filters' } = Astro.props;
---

<ul class:list={['tags', `tags--${variant}`]} aria-label="Disciplines">
  {disciplines.map((d) => (
    <li><a href={url(`discipline/${slugify(d)}`)}>{d}</a></li>
  ))}
</ul>
