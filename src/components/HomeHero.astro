---
/**
 * The home-page introduction with a quiet, asynchronous photographic sequence.
 * Images are decorative: the visible hero copy carries the page's accessible name.
 */
import { Image } from 'astro:assets';
import { SITE } from '../lib/site';
import portraitBlack from '../assets/images/home-hero/portrait-black.png';
import portraitFront from '../assets/images/home-hero/portrait-front.png';
import portraitProfile from '../assets/images/home-hero/portrait-profile.png';
import portraitSide from '../assets/images/home-hero/portrait-side.png';
import danceLeap from '../assets/images/home-hero/dance-leap.png';
import danceOutdoorVeil from '../assets/images/home-hero/dance-outdoor-veil.png';
import dancePowder from '../assets/images/home-hero/dance-powder.png';
import danceSuspended from '../assets/images/home-hero/dance-suspended.png';
import danceVeilLeap from '../assets/images/home-hero/dance-veil-leap.png';

interface Props {
  headline?: string;
  emphasis?: string;
  description?: string;
}

const { headline = SITE.name, emphasis, description = SITE.tagline } = Astro.props;

const photographs = [
  { image: portraitBlack, kind: 'portrait', name: 'portrait-black' },
  { image: danceVeilLeap, kind: 'movement', name: 'dance-veil-leap' },
  { image: danceSuspended, kind: 'suspended', name: 'dance-suspended' },
  { image: portraitFront, kind: 'portrait', name: 'portrait-front' },
  { image: danceLeap, kind: 'movement', name: 'dance-leap' },
  { image: portraitProfile, kind: 'portrait', name: 'portrait-profile' },
  { image: dancePowder, kind: 'powder', name: 'dance-powder' },
  { image: danceOutdoorVeil, kind: 'outdoor', name: 'dance-outdoor-veil' },
  { image: portraitSide, kind: 'portrait', name: 'portrait-side' },
];

const rotate = (offset: number) => photographs.map((_, index) => photographs[(index + offset) % photographs.length]);
const placement = (panel: number, index: number, kind: string) => {
  const scale = [.86, .94, .9, .98, .88, .93, .84, .96, .89][(index + panel * 2) % 9];
  const width = [78, 88, 84, 92, 80, 86, 76, 94, 82][(index + panel * 2) % 9];
  const x = ['-3%', '2%', '0%', '3%', '-2%', '1%', '-1%', '3%', '-3%'][(index + panel * 3) % 9];
  const y = ['1%', '-2%', '0%', '2%', '-1%', '1%', '-2%', '0%', '2%'][(index + panel) % 9];
  return { scale, width: kind === 'outdoor' ? 94 : width, x, y };
};
const imageOpacity = (kind: string) => {
  if (kind === 'portrait') return '.41';
  if (kind === 'movement') return '.38';
  if (kind === 'suspended') return '.38';
  if (kind === 'outdoor') return '.37';
  return '.35';
};
const imageMaxWidth = (kind: string) => {
  if (kind === 'portrait') return '420px';
  if (kind === 'movement') return '480px';
  if (kind === 'suspended') return '480px';
  if (kind === 'outdoor') return '620px';
  if (kind === 'powder') return '390px';
  return '440px';
};
const panels = [
  { position: 'left', offset: -10, images: rotate(0) },
  { position: 'center', offset: -6.67, images: rotate(3) },
  { position: 'right', offset: -3.33, images: rotate(6) },
];
---

<section class:list={['home-hero', { 'home-hero--statement': Boolean(emphasis) }]} data-home-hero>
  <div class="home-hero__art" aria-hidden="true">
    {panels.map((panel, panelIndex) => (
      <figure class={`home-hero__panel home-hero__panel--${panel.position}`}>
        {panel.images.map((photo, index) => {
          const position = placement(panelIndex, index, photo.kind);
          return (
            <Image
              class={`home-hero__image home-hero__image--${photo.kind} home-hero__image--${photo.name}`}
              src={photo.image}
              alt=""
              widths={[480, 800]}
              sizes="(min-width: 900px) 50vw, 92vw"
              format="webp"
              quality={80}
              loading="eager"
              decoding="async"
              draggable="false"
              style={`--delay: ${panel.offset + index * 10}s; --photo-opacity: ${imageOpacity(photo.kind)}; --scale: ${position.scale}; --image-width: ${position.width}%; --image-max-width: ${imageMaxWidth(photo.kind)}; --shift-x: ${position.x}; --shift-y: ${position.y};`}
            />
          );
        })}
      </figure>
    ))}
  </div>
  <div class="home-hero__wash" aria-hidden="true"></div>
  <div class="home-hero__copy">
    <p class="eyebrow">Artistic director · Choreographer · Multidisciplinary performing artist</p>
    <h1>{headline}{emphasis && <> <em>{emphasis}</em></>}</h1>
    <p>{description}</p>
  </div>
</section>

<script>
  const hero = document.querySelector<HTMLElement>('[data-home-hero]');
  if (hero && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    new IntersectionObserver(([entry]) => hero.classList.toggle('is-paused', !entry.isIntersecting), { threshold: 0.1 }).observe(hero);
  }
</script>

<style>
  .home-hero { position: relative; min-height: clamp(580px, 76vw, 810px); overflow: hidden; background: var(--paper); isolation: isolate; }
  .home-hero__art, .home-hero__wash { position: absolute; inset: 0; }
  .home-hero__panel { position: absolute; top: 0; bottom: 0; width: 58%; margin: 0; overflow: hidden; pointer-events: none; }
  .home-hero__panel--left { left: -8%; -webkit-mask-image: linear-gradient(90deg, #000 0 50%, rgb(0 0 0 / .62) 72%, transparent 100%); mask-image: linear-gradient(90deg, #000 0 50%, rgb(0 0 0 / .62) 72%, transparent 100%); }
  .home-hero__panel--center { left: 21%; -webkit-mask-image: linear-gradient(90deg, transparent 0, rgb(0 0 0 / .62) 24%, #000 43% 57%, rgb(0 0 0 / .62) 76%, transparent 100%); mask-image: linear-gradient(90deg, transparent 0, rgb(0 0 0 / .62) 24%, #000 43% 57%, rgb(0 0 0 / .62) 76%, transparent 100%); }
  .home-hero__panel--right { right: -8%; -webkit-mask-image: linear-gradient(90deg, transparent 0, rgb(0 0 0 / .62) 28%, #000 50% 100%); mask-image: linear-gradient(90deg, transparent 0, rgb(0 0 0 / .62) 28%, #000 50% 100%); }
  .home-hero__image { --perimeter-mask: radial-gradient(ellipse 78% 82% at 50% 50%, #000 49%, rgb(0 0 0 / .65) 68%, rgb(0 0 0 / .22) 82%, transparent 100%); position: absolute; top: 50%; left: 50%; display: block; width: min(var(--image-width), var(--image-max-width)); height: auto; max-height: 90%; opacity: 0; filter: grayscale(1) blur(.35px); transform: translate(-50%, -50%) translate(var(--shift-x), var(--shift-y)) scale(var(--scale)); -webkit-mask-image: var(--perimeter-mask); mask-image: var(--perimeter-mask); animation: home-hero-crossfade 90s cubic-bezier(.45, 0, .55, 1) infinite; animation-delay: var(--delay); }
  .home-hero__image--suspended { height: min(72%, 576px); max-height: none; aspect-ratio: 5 / 6; object-fit: cover; object-position: center top; }
  .home-hero__image--powder { --perimeter-mask: radial-gradient(ellipse 62% 66% at 50% 50%, #000 32%, rgb(0 0 0 / .45) 52%, rgb(0 0 0 / .12) 74%, transparent 100%); }
  .home-hero__image--outdoor { --perimeter-mask: radial-gradient(ellipse 82% 66% at 50% 50%, #000 38%, rgb(0 0 0 / .6) 64%, rgb(0 0 0 / .18) 80%, transparent 100%); }
  /* Intersect each existing all-edge mask with a bottom fade; the image box and pixels do not change. */
  .home-hero__image--portrait-black,
  .home-hero__image--portrait-side,
  .home-hero__image--portrait-profile,
  .home-hero__image--dance-suspended,
  .home-hero__image--dance-outdoor-veil {
    -webkit-mask-image: var(--perimeter-mask), linear-gradient(to bottom, #000 0 var(--bottom-fade-start), transparent 98%);
    -webkit-mask-composite: source-in;
    mask-image: var(--perimeter-mask), linear-gradient(to bottom, #000 0 var(--bottom-fade-start), transparent 98%);
    mask-composite: intersect;
  }
  .home-hero__image--portrait-black { --bottom-fade-start: 64%; }
  .home-hero__image--portrait-side { --bottom-fade-start: 68%; }
  .home-hero__image--portrait-profile { --bottom-fade-start: 68%; }
  /* Its raised hands begin just below the top edge, so finish this extra feather by 7%. */
  .home-hero__image--dance-suspended {
    -webkit-mask-image: var(--perimeter-mask), linear-gradient(to bottom, transparent 0, #000 7% 72%, transparent 98%);
    mask-image: var(--perimeter-mask), linear-gradient(to bottom, transparent 0, #000 7% 72%, transparent 98%);
  }
  .home-hero__image--dance-outdoor-veil { --bottom-fade-start: 72%; }
  .home-hero__wash { z-index: 1; background: linear-gradient(to bottom, rgb(var(--paper-rgb) / .08), transparent 14%, transparent 58%, rgb(var(--paper-rgb) / .24) 76%, rgb(var(--paper-rgb) / .58) 100%), linear-gradient(90deg, rgb(var(--paper-rgb) / .12), transparent 15% 85%, rgb(var(--paper-rgb) / .12)), rgb(var(--paper-rgb) / 66%); }
  .home-hero__copy { position: relative; z-index: 2; display: grid; align-content: center; min-height: clamp(580px, 76vw, 810px); max-width: calc(var(--wide) + 2 * var(--gutter)); padding: 0 var(--gutter); margin: 0 auto; transform: translateY(clamp(-190px, -15vw, -110px)); }
  .home-hero__copy h1 { margin: 18px 0 26px; font-size: clamp(62px, calc(12vw - 19px), 159px); font-weight: 400; line-height: .88; letter-spacing: -.03em; }
  .home-hero--statement .home-hero__copy h1 { max-width: 1000px; font-size: clamp(68px, 9.4vw, 126px); }
  .home-hero__copy h1 em { font-weight: 400; }
  .home-hero__copy > p:last-child { max-width: 24em; font-family: var(--font-display); font-size: clamp(22px, calc(2.4vw - 2px), 30px); font-style: italic; line-height: 1.3; color: var(--ink-soft); }
  .is-paused .home-hero__image { animation-play-state: paused; }

  @keyframes home-hero-crossfade { 0% { opacity: 0; } 3.333%, 11.111% { opacity: var(--photo-opacity); } 14.444%, 100% { opacity: 0; } }

  @media (min-width: 651px) {
    .home-hero__image { top: calc(50% - clamp(72px, 10vw, 132px)); }
  }

  @media (max-width: 650px) {
    .home-hero { min-height: 570px; }
    .home-hero__panel { display: none; width: 100%; }
    .home-hero__panel--center { display: block; left: 0; }
    .home-hero__panel--center .home-hero__image { width: min(var(--image-width), 92%, var(--image-max-width)); }
    .home-hero__wash { background: linear-gradient(180deg, rgb(var(--paper-rgb) / 90%), rgb(var(--paper-rgb) / 72%)); }
    .home-hero__copy { min-height: 570px; padding: 0 var(--gutter); transform: translateY(-64px); }
    .home-hero__copy h1 { font-size: clamp(58px, 17vw, 96px); }
    .home-hero--statement .home-hero__copy h1 { font-size: clamp(58px, 14vw, 86px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-hero__panel:not(.home-hero__panel--center) { display: none; }
    .home-hero__image { animation: none; }
    .home-hero__image:not(:first-child) { display: none; }
    .home-hero__image:first-child { opacity: .41; }
  }
</style>
