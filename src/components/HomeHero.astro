---
/**
 * The home-page introduction with a quiet, asynchronous photographic sequence.
 * Images are decorative: the visible hero copy carries the page's accessible name.
 */
import { Image } from 'astro:assets';
import { SITE } from '../lib/site';
import portraitBlack from '../assets/images/home-hero/portrait-black.png';
import portraitFront from '../assets/images/home-hero/portrait-front.png';
import portraitProfile from '../assets/images/home-hero/portrait-profile.png';
import portraitSide from '../assets/images/home-hero/portrait-side.png';
import danceLeap from '../assets/images/home-hero/dance-leap.png';
import danceOutdoorVeil from '../assets/images/home-hero/dance-outdoor-veil.png';
import dancePowder from '../assets/images/home-hero/dance-powder.png';
import danceSuspended from '../assets/images/home-hero/dance-suspended.png';
import danceVeilLeap from '../assets/images/home-hero/dance-veil-leap.png';

const photographs = [
  { image: portraitBlack, kind: 'portrait' },
  { image: danceVeilLeap, kind: 'movement' },
  { image: danceSuspended, kind: 'movement' },
  { image: portraitFront, kind: 'portrait' },
  { image: danceLeap, kind: 'movement' },
  { image: portraitProfile, kind: 'portrait' },
  { image: dancePowder, kind: 'powder' },
  { image: danceOutdoorVeil, kind: 'outdoor' },
  { image: portraitSide, kind: 'portrait' },
];

const rotate = (offset: number) => photographs.map((_, index) => photographs[(index + offset) % photographs.length]);
const placement = (panel: number, index: number, kind: string) => {
  const scale = [.86, .94, .9, .98, .88, .93, .84, .96, .89][(index + panel * 2) % 9];
  const width = [78, 88, 84, 92, 80, 86, 76, 94, 82][(index + panel * 2) % 9];
  const x = ['-3%', '2%', '0%', '3%', '-2%', '1%', '-1%', '3%', '-3%'][(index + panel * 3) % 9];
  const y = ['1%', '-2%', '0%', '2%', '-1%', '1%', '-2%', '0%', '2%'][(index + panel) % 9];
  return { scale, width: kind === 'outdoor' ? 94 : width, x, y };
};
const imageOpacity = (kind: string) => {
  if (kind === 'portrait') return '.31';
  if (kind === 'movement') return '.28';
  if (kind === 'outdoor') return '.27';
  return '.25';
};
const panels = [
  { position: 'left', offset: -10, images: rotate(0) },
  { position: 'center', offset: -6.67, images: rotate(3) },
  { position: 'right', offset: -3.33, images: rotate(6) },
];
---

<section class="home-hero" data-home-hero>
  <div class="home-hero__art" aria-hidden="true">
    {panels.map((panel, panelIndex) => (
      <figure class={`home-hero__panel home-hero__panel--${panel.position}`}>
        {panel.images.map((photo, index) => {
          const position = placement(panelIndex, index, photo.kind);
          return (
            <Image
              class={`home-hero__image home-hero__image--${photo.kind}`}
              src={photo.image}
              alt=""
              widths={[480, 800]}
              sizes="(min-width: 900px) 50vw, 92vw"
              format="webp"
              quality={80}
              loading="eager"
              decoding="async"
              draggable="false"
              style={`--delay: ${panel.offset + index * 10}s; --photo-opacity: ${imageOpacity(photo.kind)}; --scale: ${position.scale}; --image-width: ${position.width}%; --shift-x: ${position.x}; --shift-y: ${position.y};`}
            />
          );
        })}
      </figure>
    ))}
  </div>
  <div class="home-hero__wash" aria-hidden="true"></div>
  <div class="home-hero__copy">
    <p class="eyebrow">Artistic director · Choreographer · Multidisciplinary performing artist</p>
    <h1>{SITE.name}</h1>
    <p>{SITE.tagline}</p>
  </div>
</section>

<script>
  const hero = document.querySelector<HTMLElement>('[data-home-hero]');
  if (hero && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    new IntersectionObserver(([entry]) => hero.classList.toggle('is-paused', !entry.isIntersecting), { threshold: 0.1 }).observe(hero);
  }
</script>

<style>
  .home-hero { position: relative; min-height: clamp(580px, 76vw, 810px); overflow: hidden; background: var(--paper); isolation: isolate; }
  .home-hero__art, .home-hero__wash { position: absolute; inset: 0; }
  .home-hero__panel { position: absolute; top: 0; bottom: 0; width: 44%; margin: 0; overflow: hidden; }
  .home-hero__panel::after { content: ''; position: absolute; inset: -1px; z-index: 1; pointer-events: none; background: linear-gradient(to bottom, var(--paper) 0%, rgb(243 238 230 / .22) 30%, transparent 46%), linear-gradient(to bottom, transparent 54%, rgb(243 238 230 / .22) 70%, var(--paper) 100%), radial-gradient(ellipse 79% 86% at 50% 50%, transparent 21%, rgb(243 238 230 / .12) 48%, var(--paper) 100%); }
  .home-hero__panel--left { left: 0; -webkit-mask-image: linear-gradient(90deg, #000 0 63%, transparent 100%); mask-image: linear-gradient(90deg, #000 0 63%, transparent 100%); }
  .home-hero__panel--center { left: 25%; width: 50%; -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 31%, #000 69%, transparent 100%); mask-image: linear-gradient(90deg, transparent 0, #000 31%, #000 69%, transparent 100%); }
  .home-hero__panel--right { right: 0; -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 37%, #000 100%); mask-image: linear-gradient(90deg, transparent 0, #000 37%, #000 100%); }
  .home-hero__image { position: absolute; top: 50%; left: 50%; display: block; width: var(--image-width); height: auto; max-height: 90%; opacity: 0; filter: grayscale(1); transform: translate(-50%, -50%) translate(var(--shift-x), var(--shift-y)) scale(var(--scale)); -webkit-mask-image: radial-gradient(ellipse 78% 82% at 50% 50%, #000 53%, rgb(0 0 0 / .75) 72%, transparent 100%); mask-image: radial-gradient(ellipse 78% 82% at 50% 50%, #000 53%, rgb(0 0 0 / .75) 72%, transparent 100%); animation: home-hero-crossfade 90s cubic-bezier(.45, 0, .55, 1) infinite; animation-delay: var(--delay); }
  .home-hero__image--outdoor { -webkit-mask-image: radial-gradient(ellipse 82% 66% at 50% 50%, #000 42%, rgb(0 0 0 / .7) 68%, transparent 100%); mask-image: radial-gradient(ellipse 82% 66% at 50% 50%, #000 42%, rgb(0 0 0 / .7) 68%, transparent 100%); }
  .home-hero__wash { z-index: 1; background: rgb(243 238 230 / 72%); }
  .home-hero__copy { position: relative; z-index: 2; max-width: calc(var(--wide) + 2 * var(--gutter)); padding: clamp(90px, 14vw, 170px) var(--gutter); margin: 0 auto; }
  .home-hero__copy h1 { margin: 18px 0 26px; font-size: clamp(62px, 12vw, 178px); font-weight: 400; line-height: .88; letter-spacing: -.03em; }
  .home-hero__copy > p:last-child { max-width: 24em; font-family: var(--font-display); font-size: clamp(22px, 2.4vw, 32px); font-style: italic; line-height: 1.3; color: var(--ink-soft); }
  .is-paused .home-hero__image { animation-play-state: paused; }

  @keyframes home-hero-crossfade { 0% { opacity: 0; } 3.333%, 11.111% { opacity: var(--photo-opacity); } 14.444%, 100% { opacity: 0; } }

  @media (max-width: 650px) {
    .home-hero { min-height: 570px; }
    .home-hero__panel { display: none; width: 100%; }
    .home-hero__panel--center { display: block; left: 0; }
    .home-hero__panel--center .home-hero__image { width: min(var(--image-width), 92%); }
    .home-hero__wash { background: linear-gradient(180deg, rgb(243 238 230 / 94%), rgb(243 238 230 / 76%)); }
    .home-hero__copy { padding-top: 62px; }
    .home-hero__copy h1 { font-size: clamp(58px, 17vw, 96px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-hero__panel:not(.home-hero__panel--center) { display: none; }
    .home-hero__image { animation: none; }
    .home-hero__image:not(:first-child) { display: none; }
    .home-hero__image:first-child { opacity: .31; }
  }
</style>
