---
/** A compact image-led index for long, chaptered case studies. */
import MediaImage from './MediaImage.astro';

interface Item {
  id: string;
  number: string;
  character: string;
  title: string;
  image: { src: string; alt: string };
  summary: string;
}

interface Props {
  eyebrow: string;
  heading: string;
  intro: string;
  items: Item[];
}

const { eyebrow, heading, intro, items } = Astro.props;
---

<section class="chapter-index" aria-labelledby="chapter-index-title">
  <div class="chapter-index__heading">
    <p class="eyebrow">{eyebrow}</p>
    <h2 id="chapter-index-title">{heading}</h2>
    <p>{intro}</p>
  </div>
  <nav class="chapter-index__cards" aria-label="Jump to a production chapter">
    {items.map((item) => (
      <a href={`#${item.id}`}>
        <span class="chapter-index__number">{item.number} / {item.title}</span>
        <MediaImage image={item.image} showCaption={false} sizes="(min-width: 900px) 24vw, 30vw" />
        <strong>{item.character}</strong>
        <span class="chapter-index__summary">{item.summary}</span>
      </a>
    ))}
  </nav>
</section>

<style>
  .chapter-index {
    grid-column: wide;
    display: grid;
    grid-template-columns: minmax(0, .7fr) minmax(0, 1.3fr);
    gap: clamp(28px, 5vw, 64px);
    padding: 4px 0 clamp(54px, 8vw, 90px);
  }
  .chapter-index__heading h2 {
    margin: 0 0 14px;
    font: 400 clamp(34px, 4.4vw, 58px)/.98 var(--font-display);
  }
  .chapter-index__heading > p:last-child {
    max-width: 370px;
    color: var(--ink-soft);
    line-height: 1.6;
  }
  .chapter-index__cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(10px, 1.5vw, 18px);
  }
  .chapter-index__cards a {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 10px;
    color: inherit;
    text-decoration: none;
  }
  .chapter-index__number {
    min-height: 28px;
    color: var(--muted);
    font-size: 9px;
    letter-spacing: .12em;
    text-transform: uppercase;
  }
  .chapter-index__cards .media { width: 100%; margin: 0; background: var(--paper-deep); }
  .chapter-index__cards .media img {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: contain;
  }
  .chapter-index__cards strong { font: 400 27px/1 var(--font-display); }
  .chapter-index__summary { color: var(--ink-soft); font-size: 12px; line-height: 1.45; }
  .chapter-index__cards a:hover strong,
  .chapter-index__cards a:focus-visible strong { text-decoration: underline; text-underline-offset: 4px; }
  @media (max-width: 780px) {
    .chapter-index { grid-template-columns: 1fr; gap: 24px; }
  }
  @media (max-width: 560px) {
    .chapter-index__cards { gap: 9px; }
    .chapter-index__number { font-size: 8px; }
    .chapter-index__cards strong { font-size: 21px; }
    .chapter-index__summary { font-size: 11px; }
  }
</style>
