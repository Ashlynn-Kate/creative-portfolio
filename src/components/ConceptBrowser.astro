---
/** Two views of the same content: original disclosures and an object-only mosaic. */
import type { Block } from '../content.config';
import Blocks from './Blocks.astro';
import MediaImage from './MediaImage.astro';
interface Tile { concept: string; area: string; offset?: 'raised' | 'right-down' | 'left-down'; brighten?: boolean }
interface Props { blocks: Block[]; tiles?: Tile[] }
const { blocks, tiles = [] } = Astro.props;
const concepts = blocks.filter((block): block is Extract<Block, {type: 'details'}> => block.type === 'details')
  .sort((a,b) => (a.order ?? Infinity) - (b.order ?? Infinity));
const introduction = blocks.filter(block => block.type !== 'details');
const items = concepts.map((concept, index) => ({
  concept,
  id: `concept-${index}`,
  tile: tiles.find(tile => tile.concept === concept.summary),
  image: concept.blocks.find(block => block.type === 'grid')?.images[0] ?? concept.thumbnail,
}));
---
<section class="concept-browser wide" data-concept-browser aria-label="Concept collection">
  <div class="flow"><Blocks blocks={introduction} /></div>
  <div class="concept-browser__controls" role="group" aria-label="Concept display" hidden>
    <button type="button" data-view="tiles" aria-pressed="true" aria-controls="concept-tiles">Tile view</button>
    <button type="button" data-view="list" aria-pressed="false" aria-controls="concept-list">List view</button>
  </div>
  <div class="concept-browser__tile-view" id="concept-tiles" hidden>
    <p class="concept-browser__instruction">Choose an object to discover its translation.</p>
    <div class="concept-mosaic">
      {items.map(({concept, id, tile, image}) => <button type="button" class:list={['concept-tile', tile?.offset && `concept-tile--${tile.offset}`, {'concept-tile--bright': tile?.brighten}]} style={tile ? `grid-area:${tile.area}` : undefined} data-open={id} aria-haspopup="dialog" aria-label={`Explore ${concept.summary}`}>
        {image && <MediaImage class="concept-tile__image" image={{...image, highRes: undefined}} showCaption={false} sizes="(max-width: 600px) 65vw, (min-width: 1200px) 450px, 50vw" />}
      </button>)}
    </div>
  </div>
  <div id="concept-list" class="flow"><Blocks blocks={concepts} /></div>
  {items.map(({concept,id}) => <dialog id={id} class="concept-dialog" aria-label={concept.summary}>
    <div class="concept-dialog__bar"><p class="eyebrow">Object Translations</p><button type="button" data-close autofocus>Close</button></div>
    <div class="flow"><Blocks blocks={[concept]} /></div>
  </dialog>)}
</section>
<script>
  document.querySelectorAll<HTMLElement>('[data-concept-browser]').forEach(browser => {
    const controls = browser.querySelector<HTMLElement>('.concept-browser__controls');
    const tileView = browser.querySelector<HTMLElement>('#concept-tiles');
    const listView = browser.querySelector<HTMLElement>('#concept-list');
    if (!controls || !tileView || !listView) return;
    // With JavaScript unavailable, the original list remains completely usable.
    controls.hidden = false;
    tileView.hidden = false;
    listView.hidden = true;
    controls.querySelectorAll<HTMLButtonElement>('[data-view]').forEach(button => {
      button.addEventListener('click', () => {
        const showTiles = button.dataset.view === 'tiles';
        tileView.hidden = !showTiles;
        listView.hidden = showTiles;
        controls.querySelectorAll('[data-view]').forEach(control => control.setAttribute('aria-pressed', String(control === button)));
      });
    });
    browser.querySelectorAll<HTMLButtonElement>('[data-open]').forEach(button => {
      button.addEventListener('click', () => {
        const dialog = browser.querySelector<HTMLDialogElement>(`#${button.dataset.open}`);
        if (!dialog) return;
        const disclosure = dialog.querySelector<HTMLDetailsElement>('.details--concept');
        if (disclosure) disclosure.open = true;
        dialog.showModal();
        dialog.scrollTop = 0;
      });
    });
    browser.querySelectorAll<HTMLDialogElement>('.concept-dialog').forEach(dialog => {
      dialog.querySelector('[data-close]')?.addEventListener('click', () => dialog.close());
      // Reuse the original concept renderer and its approved responsive gallery.
      const summary = dialog.querySelector<HTMLElement>('.flow > .details > summary');
      if (summary) {
        summary.tabIndex = -1;
        summary.addEventListener('click', event => event.preventDefault());
      }
      dialog.addEventListener('click', event => {
        if (event.target !== dialog) return;
        const bounds = dialog.getBoundingClientRect();
        if (event.clientX < bounds.left || event.clientX > bounds.right || event.clientY < bounds.top || event.clientY > bounds.bottom) dialog.close();
      });
    });
  });
</script>
<style>
  .concept-browser { min-width: 0; }
  .concept-browser [hidden] { display: none !important; }
  .concept-browser__controls { display: flex; gap: 10px; margin: 28px 0 26px; }
  .concept-browser__controls button, .concept-dialog__bar button { padding: 10px 18px; border: 1px solid var(--line); border-radius: 0; background: transparent; color: var(--ink-soft); font: inherit; font-size: 14px; cursor: pointer; }
  .concept-browser__controls button[aria-pressed="true"] { border-color: var(--ink); color: var(--ink); background: var(--paper-deep); }
  .concept-browser__controls button:focus-visible, .concept-dialog__bar button:focus-visible { outline: 2px solid var(--control-tone); outline-offset: 3px; }
  .concept-browser__instruction { margin: 0 0 54px; font-size: 16px; }
  .concept-mosaic { display: grid; position: relative; width: min(100%,900px); margin: 0 auto 48px; isolation: isolate; background: #e7e7e4; grid-template-columns: repeat(12,minmax(0,1fr)); grid-auto-rows: clamp(58px,7.5vw,100px); gap: 4px;
    grid-template-areas: 'a a a a b b b c c c c c' 'a a a a b b b c c c c c' 'a a a a d d d c c c c c' 'e e e e d d d f f f f f' 'e e e e d d d f f f f f' 'g g g g g g h h h i i i' 'g g g g g g h h h i i i' 'g g g g g g h h h i i i'; }
  .concept-mosaic::before { content: ''; position: absolute; inset: -40px -14px -48px; background: #e7e7e4; z-index: -1; }
  .concept-tile { position: relative; width: 100%; height: 100%; min-width: 0; min-height: 0; padding: 0; border: 0; border-radius: 0; background: transparent; cursor: pointer; overflow: hidden; }
  .concept-tile :global(.concept-tile__image) { position: absolute; inset: 0; width: 100%; height: 100%; max-width: none; margin: 0; }
  .concept-tile :global(img) { display: block; width: 100%; height: 100%; max-width: 100%; max-height: 100%; object-fit: contain; mix-blend-mode: multiply; transition: transform .18s ease; }
  .concept-tile:hover :global(img), .concept-tile:focus-visible :global(img) { transform: scale(1.025); }
  .concept-tile:focus-visible { outline: 2px solid var(--control-tone); outline-offset: -3px; z-index: 2; }
  .concept-tile--raised { overflow: visible; }
  .concept-tile--raised :global(.concept-tile__image) { transform: translateY(-24px); }
  .concept-tile--left-down { overflow: visible; }
  .concept-tile--left-down :global(.concept-tile__image) { transform: translate(-25%,30px); }
  .concept-tile--right-down :global(.concept-tile__image) { inset: 24px 0 0 40px; width: calc(100% - 40px); height: calc(100% - 24px); }
  .concept-tile--bright :global(img) { mix-blend-mode: normal; filter: brightness(1.08) contrast(1.06); }
  .concept-dialog { width: min(1080px,calc(100% - 32px)); max-width: calc(100% - 32px); max-height: 90dvh; margin: auto; padding: clamp(20px,4vw,44px); box-sizing: border-box; background: var(--paper); color: var(--ink); border: 1px solid var(--line); overflow-y: auto; }
  .concept-dialog::backdrop { background: rgb(0 0 0 / .55); }
  .concept-dialog__bar { display: flex; justify-content: space-between; align-items: center; gap: 20px; margin-bottom: 24px; }
  .concept-dialog__bar p { margin: 0; }
  .concept-dialog :global(.wide) { max-width: 100%; width: 100%; }
  .concept-dialog :global(.flow > .details > summary) { cursor: default; }
  .concept-dialog :global(.flow > .details > summary::after) { display: none; }
  @media (max-width: 600px) {
    .concept-mosaic { grid-template-columns: repeat(6,minmax(0,1fr)); grid-auto-rows: clamp(45px,11vw,66px); gap: 3px;
      grid-template-areas: 'a a a a b b' 'a a a a b b' 'a a a a c c' 'd d d d c c' 'd d d d c c' 'e e e f f f' 'e e e f f f' 'g g g g g g' 'g g g g g g' 'g g g g g g' 'h h i i i i' 'h h i i i i' 'h h i i i i'; }
  }
  @media (prefers-reduced-motion: reduce) {
    .concept-tile :global(img) { transition: none; }
    .concept-tile:hover :global(img), .concept-tile:focus-visible :global(img) { transform: none; }
  }
</style>
