---
/** Small leading photograph and a portrait photograph framing wrapping prose. */
import MediaImage from './MediaImage.astro';
import { md } from '../lib/site';
interface Props {
  leadingImage: { src: string; alt: string; caption?: string; highRes?: string };
  trailingImage: { src: string; alt: string; caption?: string; highRes?: string };
  body: string;
}
const { leadingImage, trailingImage, body } = Astro.props;
---
<section class="image-story wide">
  <MediaImage image={trailingImage} class="image-story__trailing" sizes="220px" />
  <MediaImage image={leadingImage} class="image-story__leading" sizes="176px" />
  <div class="prose" set:html={md(body)} />
</section>
<style>
  .image-story { display: flow-root; }
  .image-story :global(.image-story__trailing) {
    float: right;
    width: min(23%, 210px);
    margin: 0 0 16px 30px;
  }
  .image-story :global(.image-story__leading) {
    float: left;
    width: min(17.6%, 176px);
    margin: 0 24px 12px 0;
  }
  .image-story :global(figcaption) { font-size: 13px; line-height: 1.5; margin-top: 10px; }
  @media (max-width: 640px) {
    /* Stack the tall photo after the story so the two images cannot squeeze the copy. */
    .image-story { display: flex; flex-direction: column; }
    .image-story :global(.image-story__trailing) { order: 3; float: none; width: min(50%, 210px); margin: 24px 0 0 auto; }
    .image-story :global(.image-story__leading) { float: none; width: min(44%, 176px); margin: 0 0 20px; }
  }
</style>
