---
/**
 * EXAMPLE PROTOTYPE (kept in git as a reference).
 * Home hero, version A: one full-screen photo with the name over it.
 * Prototypes can import real components and images from src/.
 */
import MediaImage from '../../src/components/MediaImage.astro';
---

<section class="hero-a">
  <MediaImage image={{ src: 'prince-of-egypt/palace.png', alt: '' }} showCaption={false} eager sizes="100vw" />
  <div class="hero-a__text">
    <p class="eyebrow">Artistic director · Choreographer</p>
    <h1>Ashlynn Kate</h1>
  </div>
</section>

<style>
  .hero-a {
    position: relative;
    height: 100vh;
    overflow: hidden;
    background: var(--stage);
  }
  .hero-a :global(.media),
  .hero-a :global(img) {
    height: 100%;
    width: 100%;
    object-fit: cover;
    opacity: 0.6;
  }
  .hero-a__text {
    position: absolute;
    left: var(--gutter);
    bottom: 12vh;
    color: var(--paper);
  }
  .hero-a__text .eyebrow {
    color: inherit;
  }
  .hero-a h1 {
    font-size: clamp(64px, 13vw, 200px);
    font-weight: 400;
    line-height: 0.9;
  }
</style>
